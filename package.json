{
    "name": "mecha-turk",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "description": "Mecha Turk: GitHub → OpenChamber agent dispatch. A local service polls bound repositories for assignment, mention, and review-request triggers; the panel relays each queued event into a host.startSession() session.",
    "license": "MIT",
    "engines": {
        "node": ">=20.19.0"
    },
    "openchamber": {
        "apiVersion": 1,
        "engines": {
            "openchamber": ">=1.24.0"
        },
        "contributes": {
            "panel": {
                "id": "mecha-turk",
                "name": "Mecha Turk",
                "icon": "github",
                "entry": "panel/index.html"
            },
            "capabilities": [
                "sessions",
                "prompt"
            ],
            "integration": {
                "name": "GitHub (token)",
                "description": "Optional, non-authoritative GitHub token card (FR-011): shows a connected-login badge and backs one read-only identity diagnostic. Never used for polling, discovery, or dispatch — service accounts are the credential path. The token stays with OpenChamber and never reaches the panel.",
                "token": {
                    "apiOrigin": "https://api.github.com",
                    "account": {
                        "path": "/user",
                        "name": "login"
                    },
                    "scheme": "bearer"
                },
                "settings": [
                    {
                        "id": "repository",
                        "label": "Repository (owner/name)"
                    },
                    {
                        "id": "expected-login",
                        "label": "Expected GitHub login (validation only, optional)"
                    },
                    {
                        "id": "expected-agent",
                        "label": "Expected session agent (default: project-manager)"
                    },
                    {
                        "id": "project-id",
                        "label": "OpenChamber project ID"
                    },
                    {
                        "id": "worktree-option",
                        "label": "Worktree option (none | generated | new:branch-name)"
                    },
                    {
                        "id": "poll-interval-ms",
                        "label": "Poll interval in milliseconds (15000-300000)"
                    }
                ]
            },
            "service": {
                "entry": "service/main.js",
                "runtime": "host"
            }
        }
    },
    "scripts": {
        "build": "npm run build:panel && npm run build:service",
        "build:panel": "bunx openchamber-guest-bundle panel/main.ts panel/main.js",
        "build:service": "bunx openchamber-guest-bundle --node service/main.ts service/main.js",
        "format": "eslint . --fix",
        "format:check": "eslint .",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "verify": "npm run build && npm run lint && npm run typecheck && npm run test"
    },
    "dependencies": {
        "@openchamber/sdk": "1.24.2"
    },
    "devDependencies": {
        "@types/node": "26.6.3",
        "eslint": "10.11.0",
        "eslint-config-shaunburdick": "9.0.1",
        "typescript": "6.0.3",
        "vitest": "5.0.2"
    }
}
