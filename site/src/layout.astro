---
/**
 * The page shell. Navigation, the footer, and the page's own `<h1>` are the
 * furniture every page must carry, so they live here and every page inherits
 * them rather than repeating them (FR-004, NFR-004, FR-076; plan D6). A page
 * supplies its heading and its body, and nothing else.
 */
import Footer from './components/footer.astro';
import Nav from './components/nav.astro';

interface Props {
    /** The page's own name; omitted on the landing page, which is the site. */
    readonly title?: string;
}

const { title } = Astro.props;
const documentTitle = title === undefined ? 'Mecha Turk' : `${title} · Mecha Turk`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{documentTitle}</title>
    </head>
    <body>
        <Nav />
        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style is:global>
    /* One light theme, declared rather than inherited: NFR-004's contrast floor
       is a measurable property of this block, and a reader's OS dark-mode
       preference must not be what decides whether it holds. Body text is
       #111111 on #ffffff (18.9:1) and links are #0a4a8f (8.8:1 on #ffffff,
       8.1:1 on the #f6f6f6 the furniture sits on) — every pair clears 4.5:1. */
    :root {
        color-scheme: light;
        --text: #111111;
        --link: #0a4a8f;
        --rule: #d4d4d4;
        --surface: #f6f6f6;
    }

    body {
        background: #ffffff;
        color: var(--text);
        font-family: system-ui, -apple-system, 'Segoe UI', roboto, arial, sans-serif;
        font-size: 1rem;
        line-height: 1.6;
        margin: 0 auto;
        max-width: 46rem;
        padding: 1.5rem 1.25rem 3rem;
    }

    a {
        color: var(--link);
    }

    /* Visible on keyboard focus without relying on the browser default, which
       is removed on some surfaces once a colour is set on `a`. */
    a:focus-visible {
        outline: 2px solid var(--text);
        outline-offset: 2px;
    }

    nav,
    footer {
        border-bottom: 1px solid var(--rule);
        padding-block: 0.5rem;
    }

    footer {
        background: var(--surface);
        border-bottom: 0;
        border-top: 1px solid var(--rule);
        margin-top: 3rem;
    }

    nav ul,
    footer ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    nav a[aria-current='page'] {
        font-weight: 700;
    }

    h1 {
        font-size: 1.9rem;
        line-height: 1.25;
        margin-block: 1.5rem 0.5rem;
    }

    h2 {
        font-size: 1.3rem;
        line-height: 1.3;
        margin-block: 2rem 0.5rem;
    }

    h1 + p {
        margin-top: 0;
    }
</style>