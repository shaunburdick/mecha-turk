---
/**
 * The page shell. Navigation, the footer, and the page's own `<h1>` are the
 * furniture every page must carry, so they live here and every page inherits
 * them rather than repeating them (FR-004, NFR-004, FR-076; plan D6). A page
 * supplies its heading and its body, and nothing else.
 *
 * **Known edge, recorded rather than fixed.** `Astro.props.title` is where an
 * `.astro` page's own name arrives. A markdown page passes frontmatter, so its
 * title is at `Astro.props.frontmatter.title` and this reads `undefined` — every
 * `.md` page would then inherit one `<title>` across the site. That is inert
 * while all five pages are `.astro` (AC-001 publishes exactly five, and
 * `assert-build.mjs` fails on a sixth), and it is a two-line fix at the point a
 * `.md` page is actually added. It is written down here because the failure
 * mode is a silently wrong `<title>` on every page at once, which is the shape
 * of thing that is cheap to prevent and awkward to diagnose.
 */
import Footer from './components/footer.astro';
import Nav from './components/nav.astro';

interface Props {
    /** The page's own name; omitted on the landing page, which is the site. */
    readonly title?: string;
}

const { title } = Astro.props;
const documentTitle = title === undefined ? 'Mecha Turk' : `${title} · Mecha Turk`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{documentTitle}</title>
    </head>
    <body>
        <Nav />
        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style is:global>
    /* One light theme, declared rather than inherited: NFR-004's contrast floor
       is a measurable property of this block, and a reader's OS dark-mode
       preference must not be what decides whether it holds. Body text is
       #111111 on #ffffff (18.9:1) and links are #0a4a8f (8.8:1 on #ffffff,
       8.1:1 on the #f6f6f6 the furniture sits on) — every pair clears 4.5:1. */
    :root {
        color-scheme: light;
        --text: #111111;
        --link: #0a4a8f;
        --rule: #d4d4d4;
        --surface: #f6f6f6;
    }

    body {
        background: #ffffff;
        color: var(--text);
        font-family: system-ui, -apple-system, 'Segoe UI', roboto, arial, sans-serif;
        font-size: 1rem;
        line-height: 1.6;
        margin: 0 auto;
        max-width: 46rem;
        padding: 1.5rem 1.25rem 3rem;
    }

    a {
        color: var(--link);
    }

    /* Visible on keyboard focus without relying on the browser default, which
       is removed on some surfaces once a colour is set on `a`. */
    a:focus-visible {
        outline: 2px solid var(--text);
        outline-offset: 2px;
    }

    nav,
    footer {
        border-bottom: 1px solid var(--rule);
        padding-block: 0.5rem;
    }

    footer {
        background: var(--surface);
        border-bottom: 0;
        border-top: 1px solid var(--rule);
        margin-top: 3rem;
    }

    nav ul,
    footer ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    nav a[aria-current='page'] {
        font-weight: 700;
    }

    /* Five of the pages carry real tables — the permission list, the settings
       fields, the dispatch states, the symptom codes, and the identifier
       mapping — and they are the densest thing on the site. These rules give
       them the same furniture `nav` and `footer` already have, from the same
       two custom properties, so a table reads as part of this page rather than
       as markup that arrived without a stylesheet.

       The browser centres a `<th>`, which is right for a numeric column and
       wrong for a page of sentences, so every header here is aligned the way
       the text under it runs. `border-collapse` with a rule per row is used in
       preference to a box around each cell: nine tables of four columns would
       otherwise be a grid, and the reader wants rows. */
    table {
        border-collapse: collapse;
        display: block;
        margin-block: 1rem 1.5rem;
        max-width: 100%;
        overflow-x: auto;
        width: 100%;
    }

    caption {
        color: var(--text);
        font-weight: 700;
        padding-block: 0 0.4rem;
        text-align: left;
    }

    th,
    td {
        border-bottom: 1px solid var(--rule);
        padding: 0.4rem 0.75rem 0.4rem 0;
        text-align: left;
        vertical-align: top;
    }

    thead th {
        border-bottom: 2px solid var(--rule);
        white-space: nowrap;
    }

    /* The last row's rule would otherwise sit under the table as a stray line. */
    tbody tr:last-child th,
    tbody tr:last-child td {
        border-bottom: 0;
    }

    /* A cell is prose — the dispatch-state and symptom tables carry whole
       sentences — so a long token breaks rather than forcing the table wider
       than the column. `anywhere` rather than `break-word` because the
       difference is that this one also breaks *inside* a word when that word
       alone would overflow, which is the case here. */
    th,
    td,
    caption {
        overflow-wrap: anywhere;
    }

    /* At the width the rail gives a panel and the width a phone gives a page,
       four columns leave no room for the padding. */
    @media (max-width: 30rem) {
        th,
        td {
            padding-right: 0.5rem;
        }

        table {
            font-size: 0.95rem;
        }
    }

    /* A definition list is the landing page's shape for "term, then what it
       means" — the six tabs, and the two places state lives — and the browser's
       default 40px indent on a `<dd>` reads as an accident beside a table that
       now has rules. Kept as a list rather than converted: it is a glossary
       here, not a table, and FR-015's "six tabs in this order, one line each"
       is a list of terms. */
    dl {
        margin-block: 0 1rem;
    }

    dt {
        font-weight: 700;
        margin-block: 0.75rem 0.1rem;
    }

    dd {
        margin: 0 0 0 1.25rem;
    }

    h1 {
        font-size: 1.9rem;
        line-height: 1.25;
        margin-block: 1.5rem 0.5rem;
    }

    h2 {
        font-size: 1.3rem;
        line-height: 1.3;
        margin-block: 2rem 0.5rem;
    }

    h1 + p {
        margin-top: 0;
    }
</style>