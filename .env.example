# Mecha Turk — spike configuration template (T004)
#
# HOW THIS IS USED
# The OpenChamber extension spike does NOT read this file at runtime: a
# sandboxed panel has no filesystem access, and no `files`/`filesystem`
# capability is declared. The values below are what the operator types into
# OpenChamber's integration card (Settings → Integrations → GitHub (token))
# and the extension's settings fields. This template exists so the run is
# reproducible and so nobody has to invent field names under time pressure.
#
# RULES
# - Never put a real credential in this file. `.env*` is git-ignored except
#   for this template; the GitHub PAT is entered once into OpenChamber and is
#   attached to host.request() calls by the host.
# - Every value here is plain, non-secret operator configuration.

# Repository polled by the spike (exactly one). Format: owner/name
MECHA_TURK_REPOSITORY=owner/name

# Optional validation constraint: the login the PAT is expected to belong to.
# The discovered /user login is authoritative; a mismatch blocks the poll.
MECHA_TURK_EXPECTED_LOGIN=

# OpenChamber project id the dispatched session must target. OPTIONAL if you
# use the panel's project picker: the panel lists host.listProjects() and
# stores your pick in extension storage (key mecha-turk-spike:project), which
# takes precedence over this field. Set it as the fallback for a fresh install
# or headless configuration. A missing id from both sources blocks dispatch
# (FR-020) — the spike never creates a project implicitly.
MECHA_TURK_PROJECT_ID=

# Worktree option passed to host.startSession():
#   none              -> start in the project's target directory
#   generated         -> ask OpenChamber to generate a worktree
#   new:<branch-name> -> ask OpenChamber for a named new worktree/branch
MECHA_TURK_WORKTREE_OPTION=generated

# Poll cadence in milliseconds. Clamped to 15000..300000; empty uses 60000.
MECHA_TURK_POLL_INTERVAL_MS=60000

# GitHub credential — ENTERED IN THE OPENCHAMBER UI ONLY.
# Fine-grained PAT, repository scope on the single test repository, with
# Metadata: read and Issues: read (see FR-015). Leave this line commented; a
# value here must never be committed.
# GITHUB_PAT=
