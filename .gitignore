# Dependencies
node_modules/

# Local secrets and environment files — credentials never enter source control.
# There is no template to except any more: 006 FR-091 removed `.env.example`,
# the two surviving service variables are host-set, and no `.env` file ships.
.env
.env.*

# Test/coverage output. The committed guest bundles (panel/main.js, the panel
# IIFE, and service/main.js, the service ESM) are intentionally committed:
# OpenChamber does not build TypeScript on install.
coverage/
*.tsbuildinfo

# Logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor state
.vscode/
.idea/
*.swp

# Screenshot output from `npm run shot` (tools/visual) lands in the repo-root
# `screenshots/` folder, visible to the operator but never committed; `--out`
# can point anywhere else. The older temp/repo-root paths stay covered so a
# stray capture cannot enter the index either.
screenshots/
tools/visual/*.png
/panel-*.png
